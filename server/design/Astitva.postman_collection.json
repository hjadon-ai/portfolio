{
  "info": {
    "name": "Astitva API",
    "description": "Requests for the local Astitva Express server. Mailpit receives verification and password-reset messages at http://localhost:8025. Postman keeps the login session cookie automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "response": []
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{userName}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/signup"
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "response": []
        },
        {
          "name": "Verify email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/verify-email",
            "description": "Copy the token query parameter from the verification link shown in Mailpit."
          },
          "response": []
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "response": []
        },
        {
          "name": "Resend verification email",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/resend-verification"
          },
          "response": []
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/forgot-password"
          },
          "response": []
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"password\": \"{{newPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/reset-password",
            "description": "Copy the token query parameter from the password-reset link shown in Mailpit."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Diet (verified login required)",
      "item": [
        {
          "name": "Get day",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/diet/days/{{dietDate}}",
            "header": []
          },
          "response": []
        },
        {
          "name": "Add meal",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/diet/meals",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{dietDate}}\",\n  \"name\": \"Oatmeal\",\n  \"mealType\": \"breakfast\",\n  \"servingDescription\": \"1 bowl\",\n  \"nutrition\": {\n    \"calories\": 420,\n    \"proteinGrams\": 18,\n    \"carbohydrateGrams\": 62,\n    \"fatGrams\": 12,\n    \"fiberGrams\": 8.5\n  }\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.environment.set(\"mealId\", pm.response.json().meal.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Edit meal",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/diet/meals/{{mealId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nutrition\": {\n    \"fiberGrams\": 9.5\n  }\n}"
            }
          },
          "response": []
        },
        {
          "name": "Save targets",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/diet/targets",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"calories\": 2000,\n  \"proteinGrams\": 100,\n  \"carbohydrateGrams\": 240,\n  \"fatGrams\": 65,\n  \"fiberGrams\": 30\n}"
            }
          },
          "response": []
        },
        {
          "name": "Delete meal",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/diet/meals/{{mealId}}",
            "header": []
          },
          "response": []
        }
      ]
    }
  ]
}
