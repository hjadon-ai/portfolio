{
  "info": {
    "name": "Astitva API",
    "description": "Requests for the local Astitva Express server. Mailpit receives verification and password-reset messages at http://localhost:8025. Diet includes F008 water tracking, Meal Library, and CSV preview/import. Finance uses the active Dev/Sandbox or Stage/Production credentials configured only on the server. Postman keeps the login session cookie automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "response": []
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{userName}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/signup"
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "response": []
        },
        {
          "name": "Verify email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/verify-email",
            "description": "Copy the token query parameter from the verification link shown in Mailpit."
          },
          "response": []
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "response": []
        },
        {
          "name": "Resend verification email",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/resend-verification"
          },
          "response": []
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/forgot-password"
          },
          "response": []
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"password\": \"{{newPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/reset-password",
            "description": "Copy the token query parameter from the password-reset link shown in Mailpit."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Diet (verified login required)",
      "item": [
        {
          "name": "Get day",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/diet/days/{{dietDate}}",
            "header": []
          },
          "response": []
        },
        {
          "name": "Save targets",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/diet/targets",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"calories\": 2000,\n  \"proteinGrams\": 100,\n  \"carbohydrateGrams\": 240,\n  \"fatGrams\": 65,\n  \"fiberGrams\": 30,\n  \"waterMilliliters\": 2000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Add water entry",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/diet/water-entries",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{dietDate}}\",\n  \"amountMilliliters\": 250\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.environment.set(\"waterEntryId\", pm.response.json().entry.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete water entry",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/diet/water-entries/{{waterEntryId}}",
            "header": []
          },
          "response": []
        },
        {
          "name": "Add meal",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/diet/meals",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{dietDate}}\",\n  \"name\": \"Oatmeal\",\n  \"mealType\": \"breakfast\",\n  \"servingDescription\": \"1 bowl\",\n  \"nutrition\": {\n    \"calories\": 420,\n    \"proteinGrams\": 18,\n    \"carbohydrateGrams\": 62,\n    \"fatGrams\": 12,\n    \"fiberGrams\": 8.5\n  }\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.environment.set(\"mealId\", pm.response.json().meal.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Edit meal",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/diet/meals/{{mealId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nutrition\": {\n    \"fiberGrams\": 9.5\n  }\n}"
            }
          },
          "response": []
        },
        {
          "name": "Delete meal",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/diet/meals/{{mealId}}",
            "header": []
          },
          "response": []
        },
        {
          "name": "List library meals",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/diet/library-meals?search=&category=",
            "header": []
          },
          "response": []
        },
        {
          "name": "Create library meal",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/diet/library-meals",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Oatmeal bowl\",\n  \"category\": \"breakfast\",\n  \"servingDescription\": \"1 bowl\",\n  \"nutrition\": {\n    \"calories\": 420,\n    \"proteinGrams\": 18,\n    \"carbohydrateGrams\": 62,\n    \"fatGrams\": 12,\n    \"fiberGrams\": 8.5\n  },\n  \"ingredients\": \"Rolled oats; milk; berries\",\n  \"notes\": \"Usual weekday serving\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.environment.set(\"libraryMealId\", pm.response.json().meal.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get library meal",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/diet/library-meals/{{libraryMealId}}",
            "header": []
          },
          "response": []
        },
        {
          "name": "Edit library meal",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/diet/library-meals/{{libraryMealId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Updated from Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Add library meal to day",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/diet/library-meals/{{libraryMealId}}/add-to-day",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{dietDate}}\",\n  \"mealType\": \"breakfast\",\n  \"quantity\": 1.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.environment.set(\"mealId\", pm.response.json().meal.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Preview Meal Library CSV",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/diet/library-meals/import-preview",
            "header": [],
            "description": "Choose a local UTF-8 CSV in the file field. Preview does not save records.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Confirm selected CSV rows",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/diet/library-meals/import",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rows\": [\n    {\n      \"sourceRowNumber\": 2,\n      \"name\": \"Imported yogurt bowl\",\n      \"category\": \"breakfast\",\n      \"servingDescription\": \"1 bowl\",\n      \"calories\": 310,\n      \"proteinGrams\": 22,\n      \"carbohydrateGrams\": 38,\n      \"fatGrams\": 8,\n      \"fiberGrams\": 5,\n      \"ingredients\": \"Yogurt; berries; oats\",\n      \"notes\": \"\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Delete library meal",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/diet/library-meals/{{libraryMealId}}",
            "header": []
          },
          "response": []
        }
      ]
    },
    {
      "name": "Finance (verified login required)",
      "item": [
        {
          "name": "Get Finance summary",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/finance/summary?month={{financeMonth}}",
            "header": []
          },
          "response": []
        },
        {
          "name": "List connections and accounts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/finance/connections",
            "header": []
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { const body = pm.response.json(); if (body.connections[0]) { pm.environment.set(\"financeConnectionId\", body.connections[0].id); if (body.connections[0].accounts[0]) pm.environment.set(\"financeAccountId\", body.connections[0].accounts[0].id); } }"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Plaid Link session",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/finance/connection-sessions",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Requires PLAID_CLIENT_ID, PLAID_SECRET, and FINANCE_TOKEN_ENCRYPTION_KEY on the local server. Open Plaid Link from the Finance page to use the returned temporary token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"plaid\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Complete Plaid connection",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/finance/connections",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Paste a fresh short-lived public token from a the active Plaid environment Link flow into plaidPublicToken. The web page normally performs this exchange automatically.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"plaid\",\n  \"exchangeToken\": \"{{plaidPublicToken}}\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.environment.set(\"financeConnectionId\", pm.response.json().connection.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh all Finance data",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/finance/sync",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "response": []
        },
        {
          "name": "Get account detail",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/finance/accounts/{{financeAccountId}}",
            "header": []
          },
          "response": []
        },
        {
          "name": "Stop tracking account",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/finance/accounts/{{financeAccountId}}",
            "header": []
          },
          "response": []
        },
        {
          "name": "Disconnect institution",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/finance/connections/{{financeConnectionId}}",
            "header": []
          },
          "response": []
        }
      ]
    }
  ]
}
